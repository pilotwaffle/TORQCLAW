{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "operator",
        "channel",
        "node"
      ]
    },
    "expectedRole": {
      "type": "string",
      "enum": [
        "operator",
        "channel",
        "node"
      ]
    },
    "token": {
      "type": "string"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "clientInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "surface"
            },
            "credential": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "credential"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "channel_service"
            },
            "credential": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "credential"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "clientInfo"
  ],
  "additionalProperties": false
}