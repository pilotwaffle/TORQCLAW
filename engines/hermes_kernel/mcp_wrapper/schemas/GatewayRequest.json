{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sourceChannel": {
      "type": "string"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "assembledContext": {
          "type": "string"
        },
        "contextSize": {
          "type": "number"
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "taskType": {
          "type": "string",
          "enum": [
            "DATA_EXTRACTION",
            "SUMMARIZATION",
            "ROUTINE_AUTOMATION",
            "AUTONOMOUS_RESEARCH",
            "COMPLEX_CODING"
          ]
        },
        "grantedTools": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "callerCollabPrincipalId": {
          "type": "string"
        },
        "subscriptionExecutionTarget": {
          "type": "object",
          "properties": {
            "providerId": {
              "type": "string",
              "enum": [
                "grok-subscription",
                "kimi-subscription",
                "qwen-subscription",
                "zai-subscription"
              ]
            },
            "providerAccountId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "adapterId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "exactModelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "runtimeFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "personaRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "personaContentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "confirmed": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "providerId",
            "providerAccountId",
            "adapterId",
            "modelId",
            "exactModelId",
            "runtimeFingerprint",
            "personaRevision",
            "personaContentSha256",
            "confirmed"
          ],
          "additionalProperties": false
        },
        "localExecutionTarget": {
          "type": "object",
          "properties": {
            "providerId": {
              "type": "string",
              "const": "ollama-local"
            },
            "adapterId": {
              "type": "string",
              "const": "ollama-local"
            },
            "modelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "providerId",
            "adapterId",
            "modelId"
          ],
          "additionalProperties": false
        },
        "agentPersonaEnvelope": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "const": 1
            },
            "content": {
              "type": "string",
              "maxLength": 4000
            },
            "personaRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "contentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "version",
            "content",
            "personaRevision",
            "contentSha256"
          ],
          "additionalProperties": false
        },
        "agentTurnContext": {
          "type": "object",
          "properties": {
            "channelId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "agentPrincipalId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "channelSeq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "triggerEventId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "personaRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "recoveryLeaseToken": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "channelId",
            "agentPrincipalId",
            "channelSeq",
            "triggerEventId",
            "personaRevision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "prompt",
        "contextSize",
        "requiredTools",
        "taskType",
        "grantedTools"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "latencySensitivity": {
          "type": "string",
          "enum": [
            "HIGH",
            "LOW"
          ]
        },
        "maxCost": {
          "type": "number"
        },
        "containsSensitiveData": {
          "type": "boolean"
        },
        "executionMode": {
          "default": "AUTO",
          "type": "string",
          "enum": [
            "AUTO",
            "LOCAL_ONLY",
            "CLOUD_OK"
          ]
        }
      },
      "required": [
        "latencySensitivity",
        "containsSensitiveData",
        "executionMode"
      ],
      "additionalProperties": false
    },
    "enrichment": {
      "type": "object",
      "properties": {
        "classifierUsed": {
          "type": "string",
          "enum": [
            "LOCAL_LLM",
            "KEYWORD_FALLBACK",
            "DEFAULT"
          ]
        },
        "classifierConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classifierLatencyMs": {
          "type": "number"
        },
        "estimatedTokens": {
          "type": "number"
        },
        "memoryUsed": {
          "default": true,
          "type": "boolean"
        },
        "agentReach": {
          "type": "object",
          "properties": {
            "requestedChannels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "github",
                  "twitter",
                  "youtube",
                  "reddit",
                  "facebook",
                  "instagram",
                  "bilibili",
                  "xiaohongshu",
                  "linkedin",
                  "xiaoyuzhou",
                  "v2ex",
                  "xueqiu",
                  "rss",
                  "exa_search",
                  "web"
                ]
              }
            },
            "localChannels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "github",
                  "twitter",
                  "youtube",
                  "reddit",
                  "facebook",
                  "instagram",
                  "bilibili",
                  "xiaohongshu",
                  "linkedin",
                  "xiaoyuzhou",
                  "v2ex",
                  "xueqiu",
                  "rss",
                  "exa_search",
                  "web"
                ]
              }
            },
            "frontierChannels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "github",
                  "twitter",
                  "youtube",
                  "reddit",
                  "facebook",
                  "instagram",
                  "bilibili",
                  "xiaohongshu",
                  "linkedin",
                  "xiaoyuzhou",
                  "v2ex",
                  "xueqiu",
                  "rss",
                  "exa_search",
                  "web"
                ]
              }
            },
            "localSatisfies": {
              "type": "boolean"
            },
            "frontierSatisfies": {
              "type": "boolean"
            },
            "writeIntent": {
              "type": "boolean"
            }
          },
          "required": [
            "requestedChannels",
            "localChannels",
            "frontierChannels",
            "localSatisfies",
            "frontierSatisfies",
            "writeIntent"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "classifierUsed",
        "classifierConfidence",
        "classifierLatencyMs",
        "estimatedTokens",
        "memoryUsed"
      ],
      "additionalProperties": false
    },
    "effectiveProfile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "torqclaw.effective-profile/v1"
        },
        "profileId": {
          "type": "string",
          "enum": [
            "read_only",
            "workspace_write",
            "browser_research",
            "terminal_power",
            "agent_conversation"
          ]
        },
        "profileVersion": {
          "type": "number",
          "const": 1
        },
        "toolRegistryVersion": {
          "type": "string",
          "minLength": 1
        },
        "allowedOperationIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilityClasses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "exec",
              "send"
            ]
          }
        },
        "sideEffectClasses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "filesystem_write",
              "browser_mutation",
              "process",
              "network_send",
              "collab_write"
            ]
          }
        },
        "allowedTiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "LOCAL_EDGE",
              "FRONTIER"
            ]
          }
        },
        "operationCapabilities": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "exec",
              "send"
            ]
          }
        },
        "operationSideEffects": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "none",
              "filesystem_write",
              "browser_mutation",
              "process",
              "network_send",
              "collab_write"
            ]
          }
        },
        "operationApprovals": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "scopes": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "enum": [
                "none",
                "workspace",
                "configured"
              ]
            },
            "network": {
              "type": "string",
              "enum": [
                "none",
                "browser",
                "configured"
              ]
            }
          },
          "required": [
            "path",
            "network"
          ],
          "additionalProperties": false
        },
        "approvalRequirements": {
          "type": "object",
          "properties": {
            "write": {
              "type": "boolean"
            },
            "exec": {
              "type": "boolean"
            },
            "send": {
              "type": "boolean"
            }
          },
          "required": [
            "write",
            "exec",
            "send"
          ],
          "additionalProperties": false
        },
        "policyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "profileId",
        "profileVersion",
        "toolRegistryVersion",
        "allowedOperationIds",
        "capabilityClasses",
        "sideEffectClasses",
        "allowedTiers",
        "operationCapabilities",
        "operationSideEffects",
        "operationApprovals",
        "scopes",
        "approvalRequirements",
        "policyHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "sessionId",
    "sourceChannel",
    "receivedAt",
    "payload",
    "constraints",
    "enrichment"
  ],
  "additionalProperties": false
}