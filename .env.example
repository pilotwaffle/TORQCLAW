# Production probes use a server-owned operator surface credential.
# Leave unset to read TORQCLAW_DATA_DIR/operator-credential.token.
TORQCLAW_OPERATOR_CREDENTIAL=
TORQCLAW_CHANNEL_SERVICE_TOKEN=
# Set TORQCLAW_HTTP_CHANNEL=1 only with a non-placeholder channel service token.
TORQCLAW_HOST=127.0.0.1
TORQCLAW_CONSOLE_PORT=3000
HERMES_BIND_HOST=127.0.0.1
HERMES_PORT=8000
TORQCLAW_DATA_DIR=
HERMES_ENGINE_URL=http://127.0.0.1:8000/mcp
HERMES_ENGINE_TOKEN=

# Operator-owned approval required: gates the web_search MCP tool (network egress), default off.
TORQCLAW_WEB_SEARCH_ENABLED=0

# Optional absolute DDGS executable override. By default TORQCLAW checks the
# Hermes kernel virtual environment and then PATH.
DDGS_CLI_PATH=
AGENT_REACH_CLI_PATH=
TORQCLAW_AGENT_REACH_PROBE_TTL_MS=60000

# Optional keyless fallback used only when the DDGS CLI paths fail.
# Point this at an operator-controlled SearXNG instance; no API key is needed.
SEARXNG_URL=

# Collaboration Substrate operator bootstrap (one-time, off by default until
# TORQCLAW_COLLAB_ENABLED=1). Before the FIRST connect as an operator, run:
#   pnpm --filter @torqclaw/collab build
#   node ops/bootstrap-operator.mjs
# This mints the ONE operator credential this install will ever auto-create
# and prints/writes it once to <TORQCLAW_DATA_DIR>/operator-credential.token
# -- copy it to a password manager, then delete that file. Re-running the
# script is safe: it refuses (no second operator, nothing rotated) once an
# operator principal already exists.
# To add the default Torq Builder agent to a human-owned build room, run:
#   pnpm --filter @torqclaw/collab build
#   pnpm collab:bootstrap-agent
# Collaboration participation remains opt-in for new installations.
TORQCLAW_COLLAB_ENABLED=0
TORQCLAW_COLLAB_SURFACE_COMMANDS=0
TORQCLAW_AGENT_PARTICIPATION=0
TORQCLAW_AGENT_AUTOREPLY=0
NEXT_PUBLIC_COLLAB_UI=0
OLLAMA_HOST=http://localhost:11434
TORQCLAW_LOCAL_MODEL=torq-local
# Comma-separated allowlist exposed to managed local agents. A listed model
# is execution-ready only when Ollama /api/tags reports it installed.
TORQCLAW_LOCAL_AGENT_MODELS=torq-local,torq-ai-v5
NEXT_PUBLIC_GATEWAY_URL=ws://127.0.0.1:18790/ws

# Hermes engine model config (FRONTIER tier). Leave unset to run in stub mode.
# DEFAULT recommendation = DeepSeek v4-flash: cheapest capable workhorse
# (~$0.14-0.28/M, fast, 1M context). Bring your own provider key.
#   DeepSeek:   HERMES_PROVIDER=deepseek   HERMES_MODEL=deepseek-v4-flash
#               HERMES_BASE_URL=https://api.deepseek.com
#   Anthropic:  HERMES_PROVIDER=anthropic  HERMES_MODEL=claude-sonnet-4-6
#   OpenRouter: HERMES_PROVIDER=openrouter HERMES_MODEL=anthropic/claude-sonnet-4.6
HERMES_MODEL=
HERMES_PROVIDER=
HERMES_API_KEY=
HERMES_BASE_URL=
HERMES_MAX_ITERATIONS=30
HERMES_DISABLED_TOOLSETS=delegation

# Coding-task model override (optional). When a task is COMPLEX_CODING the engine
# uses these instead of the default — e.g. Kimi K2.7 Code (256K ctx, agentic
# coding). Leave the MODEL blank to use the default provider for coding too.
HERMES_CODING_PROVIDER=kimi-for-coding
HERMES_CODING_MODEL=kimi-k2.7-code
HERMES_CODING_API_KEY=
HERMES_CODING_BASE_URL=https://api.kimi.com/coding

# Slow local GPU: route the confident-middle to cloud (privacy/LOCAL_ONLY still local).
TORQCLAW_PREFER_CLOUD=1
